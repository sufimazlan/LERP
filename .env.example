# Copy to .env and replace every value. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SECRET_KEY=change-me
# 1 for local development only: it allows plain HTTP cookies and the seed_demo command.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_SUPERUSER_PASSWORD=change-me
DB_OWNER_PASSWORD=change-me
DB_PASSWORD=change-me

# Two workers fit comfortably on a 1 vCPU / 2 GB VM.
WEB_CONCURRENCY=2

# AI stays off for every tenant until a tenant admin enables it and sets a budget.
# Leave these empty until a provider adapter is registered (Phase 3).
LERP_AI_HOSTED_PROVIDER=
LERP_AI_LOCAL_PROVIDER=
